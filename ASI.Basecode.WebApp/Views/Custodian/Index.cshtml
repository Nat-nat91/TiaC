@{
    ViewData["Title"] = "Custodian Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Custodian Dashboard</h1>
    <p class="dash-sub">Manage inventory stock, track active borrowings, and oversee reservations.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="dash-card"><div class="dash-stat-label">Total Equipment Types</div><div class="dash-stat-count">6</div></div></div>
    <div class="col-md-3"><div class="dash-card"><div class="dash-stat-label">Available Items</div><div class="dash-stat-count">18</div></div></div>
    <div class="col-md-3"><div class="dash-card"><div class="dash-stat-label">Currently Borrowed</div><div class="dash-stat-count">7</div></div></div>
    <div class="col-md-3"><div class="dash-card"><div class="dash-stat-label">Pending Requests</div><div class="dash-stat-count">4</div></div></div>
</div>

<div class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" class="form-control dash-search-input" placeholder="Search equipment by name or code..." />
        </div>
        <div class="col-md-3">
            <select class="form-select dash-search-input">
                <option selected>All Categories</option>
                <option>Camera</option>
                <option>Projector</option>
                <option>Accessories</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select dash-search-input">
                <option selected>All Status</option>
                <option>Available</option>
                <option>Currently Borrowed</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn dash-btn-reserve w-100">Search</button>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="dash fs-3 fw-bold m-0">Equipment Overview</h3>
    <span class="text-muted small">Showing 3 items</span>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="dash-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="text-center p-3 mb-3 bg-white rounded"><i class="bi bi-camera fs-1 text-secondary"></i></div>
                <h4 class="dash fs-5 fw-bold mb-1">Camera <span class="fs-6 fw-normal text-muted">(Canon EOS)</span></h4>
                <div class="small text-muted mb-2">Category: Multimedia</div>
                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Remaining Quantity:</span><span class="fw-bold text-dark">5 / 8</span>
                </div>
            </div>
            <div class="mt-3">
                <div class="mb-2"><span class="dash-pill is-available">3 Currently Borrowed</span></div>
                <button class="btn btn-outline-danger w-100 fw-bold">Manage Stock</button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dash-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="text-center p-3 mb-3 bg-white rounded"><i class="bi bi-projector fs-1 text-secondary"></i></div>
                <h4 class="dash fs-5 fw-bold mb-1">Projector <span class="fs-6 fw-normal text-muted">(Epson)</span></h4>
                <div class="small text-muted mb-2">Category: Projector</div>
                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Remaining Quantity:</span><span class="fw-bold text-dark">2 / 5</span>
                </div>
            </div>
            <div class="mt-3">
                <div class="mb-2"><span class="dash-pill is-borrowed">3 Currently Borrowed</span></div>
                <button class="btn btn-outline-danger w-100 fw-bold">Manage Stock</button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dash-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="text-center p-3 mb-3 bg-white rounded"><i class="bi bi-camera-reels fs-1 text-secondary"></i></div>
                <h4 class="dash fs-5 fw-bold mb-1">Tripod <span class="fs-6 fw-normal text-muted">(Manfrotto)</span></h4>
                <div class="small text-muted mb-2">Category: Accessories</div>
                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Remaining Quantity:</span><span class="fw-bold text-dark">11 / 12</span>
                </div>
            </div>
            <div class="mt-3">
                <div class="mb-2"><span class="dash-pill is-available">1 Currently Borrowed</span></div>
                <button class="btn btn-outline-danger w-100 fw-bold">Manage Stock</button>
            </div>
        </div>
    </div>
</div>