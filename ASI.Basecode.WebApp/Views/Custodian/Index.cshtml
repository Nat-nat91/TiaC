@model ASI.Basecode.Services.ServiceModels.DashboardViewModel
@{
    ViewData["Title"] = "Custodian Dashboard";

    string IconFor(string categoryCode) => (categoryCode ?? "") switch
    {
        "AV-MEDIA" => "bi-camera",
        "IT-TECH" => "bi-laptop",
        "EVENT-SUP" => "bi-megaphone",
        "LAB-SCI" => "bi-eyedropper",
        "SPORTS-REC" => "bi-trophy",
        "GEN-TOOLS" => "bi-tools",
        _ => "bi-box-seam"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Custodian Dashboard</h1>
    <p class="dash-sub">Manage inventory stock, track active borrowings, and oversee reservations.</p>
</div>

<!-- Metric Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="dash-card">
            <div class="dash-stat-label">Total Equipment</div>
            <div class="dash-stat-count">@Model.TotalEquipment</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dash-card">
            <div class="dash-stat-label">Available Items</div>
            <div class="dash-stat-count">@Model.AvailableItems</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dash-card">
            <div class="dash-stat-label">Currently Borrowed</div>
            <div class="dash-stat-count">@Model.CurrentlyBorrowed</div>
        </div>
    </div>
    <div class="col-md-3">
        <a asp-controller="Custodian" asp-action="Reservations" class="text-decoration-none">
            <div class="dash-card">
                <div class="dash-stat-label">Pending Requests</div>
                <div class="dash-stat-count">@Model.PendingRequests</div>
            </div>
        </a>
    </div>
</div>

<!-- Filter & Search Bar -->
<form method="get" asp-controller="Custodian" asp-action="Index" class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control dash-search-input"
                   placeholder="Search by item code, brand/model, or serial number..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select dash-search-input">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select dash-search-input">
                <option value="">All Status</option>
                <option value="available" selected="@(Model.Status == "available")">Available</option>
                <option value="borrowed" selected="@(Model.Status == "borrowed")">Currently Borrowed</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn dash-btn-reserve w-100">Search</button>
        </div>
    </div>
</form>

<!-- Equipment Inventory Grid -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="dash fs-3 fw-bold m-0">Equipment Overview</h3>
    <span class="text-muted small">Showing @Model.Items.Count of @Model.TotalEquipment items</span>
</div>

@if (Model.Items.Any())
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            var isBorrowed = Model.BorrowedItemIds.Contains(item.Id);
            <div class="col-md-4">
                <div class="dash-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-center p-3 mb-3 bg-white rounded">
                            <i class="bi @IconFor(item.Category?.CategoryCode) fs-1 text-secondary"></i>
                        </div>
                        <h4 class="dash fs-5 fw-bold mb-1">@item.BrandModel</h4>
                        <div class="small text-muted mb-1">Code: @item.ItemCode</div>
                        <div class="small text-muted mb-1">Category: @(item.Category?.CategoryName ?? "General")</div>
                        <div class="small text-muted mb-1">Location: @item.StorageLocation</div>
                        <div class="small text-muted mb-2">Condition: <span class="text-capitalize">@item.ConditionRating?.Replace("_", " ")</span></div>
                    </div>
                    <div class="mt-3">
                        <div class="mb-2">
                            @if (isBorrowed)
                            {
                                <span class="dash-pill is-borrowed">Currently Borrowed</span>
                            }
                            else
                            {
                                <span class="dash-pill is-available">@(item.Status == "available" ? "Available" : item.Status)</span>
                            }
                        </div>
                        <a asp-controller="Custodian" asp-action="Equipment" class="btn btn-outline-danger w-100 fw-bold">Manage</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="dash-card text-center text-muted py-5">
        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
        No equipment found. Try different filters, or register items on the Equipment page.
    </div>
}