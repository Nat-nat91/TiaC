@{
    ViewData["Title"] = "Borrowing History Log";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="dash dash-name m-0">Borrowing History Log</h1>
        <p class="dash-sub">View past transactions, audit trails, return conditions, and penalty summaries.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-danger btn-sm fw-bold"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV</button>
        <button class="btn dash-btn-reserve btn-sm fw-bold"><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</button>
    </div>
</div>

<div class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <label class="dash-stat-label mb-1">Search Keywords</label>
            <input type="text" class="form-control dash-search-input" placeholder="Search by Transaction ID, Borrower ID, or Item Code..." />
        </div>
        <div class="col-md-2">
            <label class="dash-stat-label mb-1">Category</label>
            <select class="form-select dash-search-input">
                <option selected>All Categories</option>
                <option>Camera</option>
                <option>Projector</option>
                <option>Accessories</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="dash-stat-label mb-1">Transaction Result</label>
            <select class="form-select dash-search-input">
                <option selected>All Transactions</option>
                <option>Returned (On-Time)</option>
                <option>Returned (Overdue)</option>
                <option>Damaged Return</option>
                <option>Canceled</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="dash-stat-label mb-1">Date Range</label>
            <input type="date" class="form-control dash-search-input" />
        </div>
        <div class="col-md-2 align-self-end">
            <button class="btn dash-btn-reserve w-100">Filter History</button>
        </div>
    </div>
</div>

<div class="dash-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="dash fs-3 fw-bold m-0">Transaction Audit Log</h3>
        <span class="text-muted small">Total Historical Records: <strong>3</strong></span>
    </div>

    <div class="table-responsive">
        <table class="table dash-table table-hover align-middle">
            <thead>
                <tr>
                    <th>Txn ID</th>
                    <th>Equipment Details</th>
                    <th>Borrower</th>
                    <th>Issued Date</th>
                    <th>Returned Date</th>
                    <th>Returned Condition</th>
                    <th>Status / Penalty</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">TXN-2026-0812</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-white rounded"><i class="bi bi-camera fs-5 text-secondary"></i></div>
                            <div><div class="fw-bold">Canon EOS 2000D</div><div class="text-muted small">EQ-CAM-001</div></div>
                        </div>
                    </td>
                    <td><div class="fw-bold">Calood, Tia</div><div class="text-muted small">ID: 2026-10492</div></td>
                    <td>Sep 24, 2026<br /><span class="text-muted small">09:00 AM</span></td>
                    <td>Sep 24, 2026<br /><span class="text-muted small">11:45 AM</span></td>
                    <td><span class="badge bg-success">Good Condition</span></td>
                    <td><span class="dash-pill is-available">Returned On-Time</span></td>
                    <td><button class="btn dash-btn-view btn-sm" title="View Audit Details"><i class="bi bi-eye"></i> View Log</button></td>
                </tr>
                <tr>
                    <td class="fw-semibold">TXN-2026-0810</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-white rounded"><i class="bi bi-projector fs-5 text-secondary"></i></div>
                            <div><div class="fw-bold">Epson EB-E01</div><div class="text-muted small">EQ-PRJ-004</div></div>
                        </div>
                    </td>
                    <td><div class="fw-bold">Berdida, Kien</div><div class="text-muted small">ID: 2026-10331</div></td>
                    <td>Sep 20, 2026<br /><span class="text-muted small">10:00 AM</span></td>
                    <td>Sep 21, 2026<br /><span class="text-muted small">08:30 AM</span></td>
                    <td><span class="badge bg-warning text-dark">Minor Wear</span></td>
                    <td><span class="dash-pill is-borrowed">Overdue (+1 Day)</span></td>
                    <td><button class="btn dash-btn-view btn-sm" title="View Audit Details"><i class="bi bi-eye"></i> View Log</button></td>
                </tr>
                <tr>
                    <td class="fw-semibold">TXN-2026-0805</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-white rounded"><i class="bi bi-camera-reels fs-5 text-secondary"></i></div>
                            <div><div class="fw-bold">Manfrotto Compact</div><div class="text-muted small">EQ-TRP-009</div></div>
                        </div>
                    </td>
                    <td><div class="fw-bold">Dela Cruz, Juan</div><div class="text-muted small">ID: 2026-10211</div></td>
                    <td>Sep 15, 2026<br /><span class="text-muted small">N/A</span></td>
                    <td>Sep 15, 2026<br /><span class="text-muted small">N/A</span></td>
                    <td><span class="badge bg-secondary">Unissued</span></td>
                    <td><span class="dash-pill is-completed">Canceled by User</span></td>
                    <td><button class="btn dash-btn-view btn-sm" title="View Audit Details"><i class="bi bi-eye"></i> View Log</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>