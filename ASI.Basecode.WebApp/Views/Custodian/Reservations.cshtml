@model ASI.Basecode.Services.ServiceModels.ReservationsPageViewModel
@{
    ViewData["Title"] = "Manage Borrow Requests & Active Loans";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Borrow Requests & Active Loans</h1>
    <p class="dash-sub">Review incoming student requests, approve or decline borrowings, and process returns.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-controller="Custodian" asp-action="Reservations" class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.Search" class="form-control dash-search-input"
                   placeholder="Search by borrower name, ID, or item code..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select dash-search-input">
                <option value="">All Equipment Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn dash-btn-reserve w-100">Filter</button>
        </div>
    </div>
</form>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-hourglass-split text-warning me-1"></i> Pending Approval Queue</h4>
                <span class="badge bg-danger rounded-pill">@Model.Pending.Count Pending</span>
            </div>

            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var r in Model.Pending)
                {
                    <div class="p-3 bg-white rounded border">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0">@r.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small">Code: @r.EquipmentItem.ItemCode</span>
                            </div>
                            <span class="badge bg-warning text-dark">Pending</span>
                        </div>
                        <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>@r.Borrower.FirstName @r.Borrower.LastName</strong> (@r.Borrower.UserId)</div>
                        <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>@($"{r.RequestedPickupDate:MMM d, yyyy - h:mm tt}")</strong></div>
                        <div class="small text-muted mb-3"><i class="bi bi-clock me-1"></i> Est. Return: <strong>@($"{r.EstimatedReturnDate:MMM d, yyyy - h:mm tt}")</strong></div>
                        <div class="d-flex gap-2 border-top pt-2">
                            <button type="button" class="btn btn-sm btn-outline-danger w-50" data-bs-toggle="modal" data-bs-target="#declineModal" data-id="@r.Id">
                                <i class="bi bi-x-circle me-1"></i> Decline
                            </button>
                            <button type="button" class="btn btn-sm dash-btn-reserve w-50" data-bs-toggle="modal" data-bs-target="#approveModal" data-id="@r.Id">
                                <i class="bi bi-check-circle me-1"></i> Approve Request
                            </button>
                        </div>
                    </div>
                }
                @if (!Model.Pending.Any())
                {
                    <div class="text-center text-muted py-3">No pending requests.</div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-bag-check text-primary me-1"></i> Approved - Awaiting Pickup</h4>
                <span class="badge bg-primary rounded-pill">@Model.Approved.Count</span>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var r in Model.Approved)
                {
                    <div class="p-3 bg-white rounded border border-primary">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0">@r.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small">Code: @r.EquipmentItem.ItemCode</span>
                            </div>
                            <span class="badge bg-primary">Approved</span>
                        </div>
                        <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>@r.Borrower.FirstName @r.Borrower.LastName</strong> (@r.Borrower.UserId)</div>
                        <div class="small text-muted mb-3"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>@($"{r.RequestedPickupDate:MMM d, yyyy - h:mm tt}")</strong></div>
                        <form method="post" asp-controller="Custodian" asp-action="ReleaseItem">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm dash-btn-reserve w-100 fw-bold">
                                <i class="bi bi-box-arrow-right me-1"></i> Release Item to Borrower
                            </button>
                        </form>
                    </div>
                }
                @if (!Model.Approved.Any())
                {
                    <div class="text-center text-muted py-3">Nothing waiting for pickup.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-box-arrow-up-right text-success me-1"></i> Active Borrowings (Out on Loan)</h4>
                <span class="badge bg-success rounded-pill">@Model.Active.Count Active</span>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var t in Model.Active)
                {
                    var due = t.Reservation?.EstimatedReturnDate;
                    var overdue = due.HasValue && due.Value < DateTime.Now;
                    <div class="p-3 bg-white rounded border @(overdue ? "border-danger" : "border-success")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-0">@t.EquipmentItem.BrandModel</h5>
                                <span class="text-muted small">Code: @t.EquipmentItem.ItemCode</span>
                            </div>
                            @if (overdue)
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="dash-pill is-borrowed">Borrowed</span>
                            }
                        </div>
                        <div class="small text-muted mb-2"><i class="bi bi-person-check me-1"></i> Issued To: <strong>@t.Borrower.FirstName @t.Borrower.LastName</strong> (@t.Borrower.UserId)</div>
                        <div class="small text-muted mb-2"><i class="bi bi-box-arrow-right me-1"></i> Handover Time: <strong>@($"{t.ActualPickupTime:MMM d, yyyy - h:mm tt}")</strong></div>
                        <div class="small text-muted mb-3"><i class="bi bi-alarm me-1"></i> Due Return: <strong class="@(overdue ? "text-danger" : "")">@($"{due:MMM d, yyyy - h:mm tt}")</strong></div>
                        <button type="button" class="btn btn-sm btn-outline-success w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal" data-id="@t.Id">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Inspect & Mark as Returned
                        </button>
                    </div>
                }
                @if (!Model.Active.Any())
                {
                    <div class="text-center text-muted py-3">No items are currently out on loan.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div class="modal fade" id="declineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-danger">Decline Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="DeclineRequest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Please specify a reason for declining this reservation request:</p>
                        <textarea name="declineReason" class="form-control dash-search-input" rows="3" placeholder="e.g. Equipment scheduled for maintenance during requested period..." required></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger fw-bold">Confirm Decline</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold">Approve Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="ApproveRequest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Optionally add a note for the borrower (pickup instructions, reminders):</p>
                        <textarea name="reviewNotes" class="form-control dash-search-input" rows="3" placeholder="e.g. Please bring your school ID at pickup."></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn dash-btn-reserve fw-bold">Confirm Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-success">Inspect & Mark as Returned</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="Custodian" asp-action="ReturnItem">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" class="modal-id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="dash-stat-label mb-1">Return Condition</label>
                            <select name="returnCondition" class="form-select dash-search-input" required>
                                <option value="good" selected>Good Condition</option>
                                <option value="minor_wear">Minor Wear & Tear</option>
                                <option value="needs_maintenance">Needs Maintenance</option>
                            </select>
                        </div>
                        <div>
                            <label class="dash-stat-label mb-1">Damage / Inspection Notes</label>
                            <textarea name="damageNotes" class="form-control dash-search-input" rows="3" placeholder="Optional notes about the item's condition..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-bold">Confirm Return</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.modal').forEach(function (modal) {
            modal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var field = modal.querySelector('.modal-id');
                if (button && field) { field.value = button.getAttribute('data-id'); }
            });
        });
    </script>
}