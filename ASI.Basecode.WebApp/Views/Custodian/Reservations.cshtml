@{
    ViewData["Title"] = "Manage Borrow Requests & Active Loans";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Borrow Requests & Active Loans</h1>
    <p class="dash-sub">Review incoming student requests, approve or decline borrowings, and process returns.</p>
</div>

<div class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" class="form-control dash-search-input" placeholder="Search by borrower name, ID, or item code..." />
        </div>
        <div class="col-md-4">
            <select class="form-select dash-search-input">
                <option selected>All Equipment Categories</option>
                <option>Camera / Multimedia</option>
                <option>Projector</option>
                <option>Accessories</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn dash-btn-reserve w-100">Filter</button>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-hourglass-split text-warning me-1"></i> Pending Approval Queue</h4>
                <span class="badge bg-danger rounded-pill">2 Pending</span>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 bg-white rounded border">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0">Canon EOS 2000D</h5>
                            <span class="text-muted small">Code: EQ-CAM-001</span>
                        </div>
                        <span class="badge bg-warning text-dark">Pending</span>
                    </div>
                    <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>Tia Calood</strong> (BSIT-4A)</div>
                    <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>Sep 28, 2026 - 9:00 AM</strong></div>
                    <div class="small text-muted mb-3"><i class="bi bi-clock me-1"></i> Est. Return: <strong>Sep 28, 2026 - 5:00 PM</strong></div>
                    <div class="d-flex gap-2 border-top pt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger w-50" data-bs-toggle="modal" data-bs-target="#declineModal">
                            <i class="bi bi-x-circle me-1"></i> Decline
                        </button>
                        <button type="button" class="btn btn-sm dash-btn-reserve w-50" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve Request
                        </button>
                    </div>
                </div>

                <div class="p-3 bg-white rounded border">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0">Manfrotto Compact Tripod</h5>
                            <span class="text-muted small">Code: EQ-TRP-009</span>
                        </div>
                        <span class="badge bg-warning text-dark">Pending</span>
                    </div>
                    <div class="small text-muted mb-2"><i class="bi bi-person-circle me-1"></i> <strong>Juan Dela Cruz</strong> (BSIT-3B)</div>
                    <div class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i> Pickup: <strong>Sep 29, 2026 - 1:00 PM</strong></div>
                    <div class="small text-muted mb-3"><i class="bi bi-clock me-1"></i> Est. Return: <strong>Sep 30, 2026 - 12:00 PM</strong></div>
                    <div class="d-flex gap-2 border-top pt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger w-50" data-bs-toggle="modal" data-bs-target="#declineModal">
                            <i class="bi bi-x-circle me-1"></i> Decline
                        </button>
                        <button type="button" class="btn btn-sm dash-btn-reserve w-50" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve Request
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="dash fs-5 fw-bold m-0"><i class="bi bi-box-arrow-up-right text-success me-1"></i> Active Borrowings (Out on Loan)</h4>
                <span class="badge bg-success rounded-pill">1 Active</span>
            </div>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 bg-white rounded border border-success">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0">Epson EB-E01 Projector</h5>
                            <span class="text-muted small">Code: EQ-PRJ-004</span>
                        </div>
                        <span class="dash-pill is-borrowed">Borrowed</span>
                    </div>
                    <div class="small text-muted mb-2"><i class="bi bi-person-check me-1"></i> Issued To: <strong>Kien Berdida</strong> (BSIT-4A)</div>
                    <div class="small text-muted mb-2"><i class="bi bi-box-arrow-right me-1"></i> Handover Time: <strong>Sep 28, 2026 - 8:30 AM</strong></div>
                    <div class="small text-muted mb-3"><i class="bi bi-alarm me-1"></i> Due Return: <strong class="text-danger">Sep 28, 2026 - 4:30 PM</strong></div>
                    <button type="button" class="btn btn-sm btn-outline-success w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal">
                        <i class="bi bi-box-arrow-in-down me-1"></i> Inspect & Mark as Returned
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div class="modal fade" id="declineModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-danger">Decline Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Custodian/DeclineRequest">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Please specify a reason for declining this reservation request:</p>
                        <textarea name="DeclineReason" class="form-control dash-search-input" rows="3" placeholder="e.g. Equipment scheduled for maintenance during requested period..." required></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger fw-bold">Confirm Decline</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold">Approve Borrow Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Custodian/ApproveRequest">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p class="small text-muted mb-2">Optionally add a note for the borrower (pickup instructions, reminders):</p>
                        <textarea name="ReviewNotes" class="form-control dash-search-input" rows="3" placeholder="e.g. Please bring your school ID at pickup."></textarea>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn dash-btn-reserve fw-bold">Confirm Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: var(--d-bg);">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title dash fw-bold text-success">Inspect & Mark as Returned</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="/Custodian/ReturnItem">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="dash-stat-label mb-1">Return Condition</label>
                            <select name="ReturnCondition" class="form-select dash-search-input" required>
                                <option value="good" selected>Good Condition</option>
                                <option value="minor_wear">Minor Wear & Tear</option>
                                <option value="damaged">Damaged</option>
                            </select>
                        </div>
                        <div>
                            <label class="dash-stat-label mb-1">Damage / Inspection Notes</label>
                            <textarea name="DamageNotes" class="form-control dash-search-input" rows="3" placeholder="Optional notes about the item's condition..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-bold">Confirm Return</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}