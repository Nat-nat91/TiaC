@using ASI.Basecode.Services.ServiceModels
@model HistoryPageViewModel
@{
    Layout = null;
    var f = Model.Filter;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Borrowing History Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { padding: 24px; font-size: 12px; }
        @@media print { .d-print-none { display: none !important; } }
    </style>
</head>
<body>
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-0">TiaC - Borrowing History Report</h3>
            <div class="text-muted">Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt")</div>
            <div class="text-muted">
                Filters:
                @(string.IsNullOrWhiteSpace(f.Search) ? "" : $"keyword '{f.Search}'; ")
                @(f.CategoryId.HasValue ? "category selected; " : "")
                @(string.IsNullOrWhiteSpace(f.Result) ? "" : $"result: {f.Result}; ")
                @(f.DateFrom.HasValue ? $"from {f.DateFrom:yyyy-MM-dd}; " : "")
                @(f.DateTo.HasValue ? $"to {f.DateTo:yyyy-MM-dd}" : "")
                @if (string.IsNullOrWhiteSpace(f.Search) && !f.CategoryId.HasValue && string.IsNullOrWhiteSpace(f.Result) && !f.DateFrom.HasValue && !f.DateTo.HasValue)
                {
                    <text>none (all records)</text>
                }
            </div>
        </div>
        <button class="btn btn-danger d-print-none" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <div class="row mb-3">
        <div class="col"><strong>Total:</strong> @Model.TotalTransactions</div>
        <div class="col"><strong>Active:</strong> @Model.ActiveLoans</div>
        <div class="col"><strong>Late returns:</strong> @Model.LateReturns (@Model.TotalDelayHours hrs)</div>
        <div class="col"><strong>Overdue now:</strong> @Model.CurrentlyOverdue</div>
        <div class="col"><strong>Damaged:</strong> @Model.DamagedReturns</div>
        <div class="col"><strong>On-time rate:</strong> @Model.OnTimeRate%</div>
    </div>

    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Txn ID</th><th>Equipment</th><th>Borrower</th><th>Handover</th>
                <th>Returned</th><th>Condition</th><th>Overdue</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Rows)
            {
                <tr>
                    <td>@HistoryPageViewModel.TxnCode(t)</td>
                    <td>@t.EquipmentItem.BrandModel (@t.EquipmentItem.ItemCode)</td>
                    <td>@t.Borrower.FirstName @t.Borrower.LastName (@t.Borrower.UserId)</td>
                    <td>@($"{t.ActualPickupTime:MMM d, yyyy h:mm tt}")</td>
                    <td>@(t.ActualReturnTime == null ? "Not returned" : $"{t.ActualReturnTime:MMM d, yyyy h:mm tt}")</td>
                    <td>@(t.ReturnCondition ?? "-")</td>
                    <td>@(t.IsOverdue ? $"Yes (+{t.DelayDurationHours}h)" : "No")</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No records.</td></tr>
            }
        </tbody>
    </table>

    <script>window.onload = function () { window.print(); };</script>
</body>
</html>